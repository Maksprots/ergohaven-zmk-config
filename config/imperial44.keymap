#include "keys_ru.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&kp TAB           &kp Q  &kp W  &kp E  &kp R             &kp T                          &kp Y  &kp U     &kp I      &kp O    &kp P     &kp BACKSPACE
&kp LEFT_CONTROL  &kp A  &kp S  &kp D  &kp F             &kp G                          &kp H  &kp J     &kp K      &kp L    &kp SEMI  &kp APOS
&kp LSHFT         &kp Z  &kp X  &kp C  &kp V             &kp B  &kp LBKT     &kp RBKT   &kp N  &kp M     &kp COMMA  &kp DOT  &kp FSLH  &kp ESC
                                       &kp LEFT_COMMAND  &mo 1  &kp SPACE    &kp ENTER  &mo 2  &kp LALT
            >;

            display-name = "Base";
            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp PG_UP PG_DN>;
        };

        nav {
            bindings = <
&trans          &kp N1     &kp N2     &kp N3      &kp N4            &kp N5                                &kp N6        &kp N7        &kp N8          &kp N9           &kp N0            &kp BACKSPACE
&trans          &kp HOME   &kp INS    &kp DELETE  &kp END           &kp LA(LSHFT)                         &trans        &kp LEFT      &kp UP          &kp RIGHT_ARROW  &kp LEFT_COMMAND  &trans
&kp LEFT_SHIFT  &kp LC(Z)  &kp LC(X)  &kp LC(C)   &kp LC(V)         &kp PRINTSCREEN  &trans       &trans  &kp CAPSLOCK  &kp LC(LEFT)  &kp DOWN_ARROW  &kp PG_UP        &kp LC(RIGHT)     &trans
                                                  &kp LEFT_COMMAND  &trans           &kp SPACE    &trans  &mo 3         &kp LEFT_ALT
            >;

            display-name = "Nav";
        };

        sym {
            bindings = <
&trans            &kp EXCL  &kp AT_SIGN  &kp HASH   &kp DOLLAR        &kp PRCNT                           &kp CARET  &kp AMPERSAND  &kp ASTRK         &kp LPAR           &kp RPAR  &kp BACKSPACE
&kp LEFT_CONTROL  &kp BSLH  &kp LPAR     &kp MINUS  &kp LESS_THAN     &kp GREATER_THAN                    &kp MINUS  &kp EQUAL      &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp NUBS  &kp GRAVE
&kp LEFT_SHIFT    &kp HASH  &kp STAR     &kp COLON  &kp FSLH          &trans            &trans    &trans  &kp UNDER  &kp PLUS       &kp LEFT_BRACE    &kp RIGHT_BRACE    &kp PIPE  &kp TILDE
                                                    &kp LEFT_COMMAND  &mo 3             &trans    &trans  &trans     &kp LEFT_ALT
            >;

            display-name = "Symbols";
        };

        adj {
            bindings = <
&bootloader  &trans  &kp F1  &kp F2   &kp F3   &kp F4                     &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2      &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR
&trans       &trans  &kp F5  &kp F6   &kp F7   &kp F8                     &out OUT_BLE  &kp C_VOL_DN  &kp C_MUTE        &kp C_VOL_UP  &trans        &studio_unlock
&trans       &trans  &kp F9  &kp F10  &kp F11  &kp F12  &trans    &trans  &out OUT_USB  &kp C_PREV    &kp C_PLAY_PAUSE  &kp C_NEXT    &trans        &trans
                                      &trans   &trans   &trans    &trans  &trans        &trans
            >;

            display-name = "Adjust";
        };
    };
};
